#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D color;
layout(binding = 1, r32f) uniform readonly image2D finer;
layout(binding = 2, r32f) uniform writeonly image2D coarser;
layout(push_constant) uniform Parameters {
    ivec2 size;
    ivec2 finerSize;
    uint fromColor;
} parameters;

float luma(vec3 rgb) {
    return dot(rgb, vec3(0.2126, 0.7152, 0.0722));
}

void main() {
    ivec2 cell = ivec2(gl_GlobalInvocationID.xy);
    if (cell.x >= parameters.size.x || cell.y >= parameters.size.y) return;
    float value;
    if (parameters.fromColor != 0u) {
        vec2 uv = (vec2(cell) + 0.5) / vec2(parameters.size);
        value = luma(textureLod(color, uv, 0.0).rgb);
    } else {
        ivec2 base = cell * 2;
        ivec2 last = parameters.finerSize - 1;
        value = 0.25 * (imageLoad(finer, min(base, last)).r + imageLoad(finer, min(base + ivec2(1, 0), last)).r + imageLoad(finer, min(base + ivec2(0, 1), last)).r + imageLoad(finer, min(base + ivec2(1, 1), last)).r);
    }
    imageStore(coarser, cell, vec4(value, 0.0, 0.0, 0.0));
}
