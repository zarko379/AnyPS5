#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D previous;
layout(binding = 1) uniform sampler2D current;
layout(binding = 2, rgba32f) uniform readonly image2D field;
layout(binding = 3, rgba16f) uniform writeonly image2D result;
layout(std430, binding = 4) buffer Statistics {
    uint costSum;
    uint blocks;
    uint fallbackPixels;
} statistics;
shared uint groupFallback;
layout(push_constant) uniform Parameters {
    ivec2 size;
    ivec2 fieldBlocks;
    float pixelsPerBlock;
    float pixelsPerUnit;
    float cutCost;
    float mismatch;
    float phase;
} parameters;

vec4 cellAt(ivec2 cell) {
    return imageLoad(field, clamp(cell, ivec2(0), parameters.fieldBlocks - 1));
}

float luma(vec3 rgb) {
    return dot(rgb, vec3(0.2126, 0.7152, 0.0722));
}

void shade(ivec2 pixel);

void main() {
    if (gl_LocalInvocationIndex == 0u) groupFallback = 0u;
    barrier();
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    bool inside = pixel.x < parameters.size.x && pixel.y < parameters.size.y;
    if (inside) shade(pixel);
    barrier();
    if (gl_LocalInvocationIndex == 0u && groupFallback != 0u) atomicAdd(statistics.fallbackPixels, groupFallback);
}

void shade(ivec2 pixel) {
    vec2 size = vec2(parameters.size);
    vec2 position = vec2(pixel) + 0.5;
    float meanCost = statistics.blocks == 0u ? 0.0 : float(statistics.costSum) / (4096.0 * float(statistics.blocks));
    if (meanCost > parameters.cutCost) {
        imageStore(result, pixel, parameters.phase < 0.5 ? textureLod(previous, position / size, 0.0) : textureLod(current, position / size, 0.0));
        atomicAdd(groupFallback, 1u);
        return;
    }
    vec2 cell = position / parameters.pixelsPerBlock - 0.5;
    ivec2 base = ivec2(floor(cell));
    vec4 before = vec4(0.0);
    vec4 after = vec4(0.0);
    vec2 chosen = vec2(0.0);
    float difference = 1e9;
    for (int i = 0; i < 4; ++i) {
        vec4 motion = cellAt(base + ivec2(i & 1, i >> 1));
        vec2 offset = motion.xy * parameters.pixelsPerUnit * 2.0;
        vec4 candidateBefore = textureLod(previous, (position - offset * parameters.phase) / size, 0.0);
        vec4 candidateAfter = textureLod(current, (position + offset * (1.0 - parameters.phase)) / size, 0.0);
        float candidate = luma(abs(candidateBefore.rgb - candidateAfter.rgb)) + 0.25 * motion.z;
        if (candidate < difference) {
            difference = candidate;
            before = candidateBefore;
            after = candidateAfter;
            chosen = offset;
        }
    }
    float fallback = smoothstep(parameters.mismatch, parameters.mismatch * 3.0, difference);
    if (fallback > 0.5) atomicAdd(groupFallback, 1u);
    bool nearPrevious = parameters.phase < 0.5;
    vec2 centre = nearPrevious ? position - chosen * parameters.phase : position + chosen * (1.0 - parameters.phase);
    vec4 low = vec4(1e9);
    vec4 high = vec4(-1e9);
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec2 at = (centre + vec2(x, y)) / size;
            vec4 neighbour = nearPrevious ? textureLod(previous, at, 0.0) : textureLod(current, at, 0.0);
            low = min(low, neighbour);
            high = max(high, neighbour);
        }
    }
    vec4 blended = clamp(mix(before, after, parameters.phase), low, high);
    imageStore(result, pixel, mix(blended, nearPrevious ? before : after, fallback));
}
