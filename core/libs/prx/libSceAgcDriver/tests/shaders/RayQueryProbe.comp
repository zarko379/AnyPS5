#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 1) in;

layout(binding = 0) uniform accelerationStructureEXT scene;

struct Ray {
    vec4 origin;
    vec4 direction;
};

struct Hit {
    uint kind;
    uint geometry;
    uint primitive;
    uint custom;
    float t;
    float u;
    float v;
    uint candidates;
};

layout(std430, binding = 1) readonly buffer Rays {
    Ray rays[];
};

layout(std430, binding = 2) writeonly buffer Hits {
    Hit hits[];
};

void main() {
    uint index = gl_GlobalInvocationID.x;
    Ray ray = rays[index];
    rayQueryEXT query;
    rayQueryInitializeEXT(query, scene, gl_RayFlagsNoneEXT, 0xff, ray.origin.xyz, ray.origin.w, ray.direction.xyz, ray.direction.w);
    uint candidates = 0u;
    while (rayQueryProceedEXT(query)) {
        if (rayQueryGetIntersectionTypeEXT(query, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
            ++candidates;
            rayQueryConfirmIntersectionEXT(query);
        }
    }
    Hit hit;
    hit.kind = rayQueryGetIntersectionTypeEXT(query, true);
    hit.candidates = candidates;
    hit.geometry = 0u;
    hit.primitive = 0u;
    hit.custom = 0u;
    hit.t = 0.0;
    hit.u = 0.0;
    hit.v = 0.0;
    if (hit.kind == gl_RayQueryCommittedIntersectionTriangleEXT) {
        hit.geometry = uint(rayQueryGetIntersectionGeometryIndexEXT(query, true));
        hit.primitive = uint(rayQueryGetIntersectionPrimitiveIndexEXT(query, true));
        hit.custom = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(query, true));
        hit.t = rayQueryGetIntersectionTEXT(query, true);
        vec2 barycentrics = rayQueryGetIntersectionBarycentricsEXT(query, true);
        hit.u = barycentrics.x;
        hit.v = barycentrics.y;
    }
    hits[index] = hit;
}
